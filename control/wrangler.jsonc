{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claw-control",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ControlRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlRoom"] }]
}
